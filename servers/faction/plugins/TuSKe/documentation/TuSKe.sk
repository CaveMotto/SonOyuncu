	ExprHorseVariant:
		ID: ExprHorseVariant
		Return type: Text
		Changers:
			set
		Patterns:
			[the] horse variant of %entity%
			%entity%'[s] horse variant
	ExprInventoryMoveInv:
		ID: ExprInventoryMoveInv
		Return type: Inventory
		Changers:
			add
			set
			remove
			remove all
			delete
		Patterns:
