			set
			remove
			delete
			reset
		Patterns:
			[the] [total] [e]xp of %player%
			%player%'[s] [total] [e]xp
	ExprFirstLogin:
		ID: ExprFirstLogin
		Return type: Date
		Changers:
			none
		Patterns:
			[the] first login of %offlineplayer%
			%offlineplayer%'[s] first login
	ExprHighiestBlock:
		ID: ExprHighiestBlock
		Return type: Block
		Changers:
