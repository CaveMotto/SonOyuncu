variables:
    {dirhem::%player%} = 0
    {kirmasayisi::%player%} = 0
	
on first join:

    set {dirhem::%player%} to 0
    set {blokistatistik::%player%} to 0
    set {kirmasayisi::%player%} to 0

# dev.sqruat - bonus

on break obsidian:
	cancel event
	set block to air
	if {kirmasayisi::%player%} = 0:
	add 1 to {kirmasayisi::%player%}
	add 1 to {blokistatistik::%player%}
	if {kirmasayisi::%player%} >= 16:
		if player has permission "dirhem.boost":
			add 288 to {dirhem::%player%}
			set {kirmasayisi::%player%} to 0
			send "&6SkyBlock &7► &b288 ⛁ &edirhem aktarıldı." to player
		else:
			set {kirmasayisi::%player%} to 0
			add 96 to {dirhem::%player%}
			send "&6SkyBlock &7► &b96 ⛁ &edirhem aktarıldı." to player



		
	
		
		
# dev.sqruat - dirhem bilgi
	
command /dirhem:
	trigger:
		send "&e&l&m--------------&6 &6Dirhem &e&l&m--------------&6"
		send ""
		send "                  &a(Dirhem %{dirhem::%player%}% ⛁)"
		send ""
		send "&6/Dirhem Market &7- &eÇeşitli özel ürünler satın alabilirsiniz"
		send "&6/Dirhem Gönder (miktar) (oyuncu) &7- &cYeni Güncellemede."
		send ""
		send "&e&l&m--------------&6 &6Dirhem &e&l&m--------------&6"
		

# dev.sqruat - admin komut

		
command /admindirhem [<text>] [<offline player>] [<number>]:
    permission: admin.dirhem
    permission message:&6SkyBlock &7► &eBunu yapmaya yetkiniz yok!
    trigger:
        if arg 1 is "ver" or "gönder" or "add":
            if arg 2 is set:
                if arg 3 is set:
                    add arg 3 to {dirhem::%arg-2%}
                    send "&6SkyBlock &7► &d%arg 2% &eAdlı oyuncuya &b%arg 3% ⛁ &edirhem gönderildi." to player
                    send "&6SkyBlock &7► &eHesabınıza &b%arg 3% ⛁ &edirhem aktarıldı." to arg 2
                else:
                    send "&6SkyBlock &7► &eBir miktar belirleyiniz."
            else:
                send "&6SkyBlock &7► &eBir kişi belirleyiniz."
		
		
# dev.sqruat - market

		
command /kazma1:
	trigger:
		if {dirhem::%player%} >= 3000:
			send "&6SkyBlock &7► &eBaşarıyla Satın Aldın."
			give 1 278 of efficiency 10 and fortune 4 and unbreaking 5 named "&d&lEDIT KAZMA V" to player
			remove 3000 from {dirhem::%player%}
		else:
			send "&6SkyBlock &7► &eYeterli dirhem'in yok."
command /kazma2:
	trigger:
		if {dirhem::%player%} >= 7000:
			send "&6SkyBlock &7► &eBaşarıyla Satın Aldın."
