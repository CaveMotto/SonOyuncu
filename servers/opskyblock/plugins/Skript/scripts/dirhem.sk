command /anahtar1:
	trigger:
		if {dirhem::%player%} >= 300000:
			send "&6SkyBlock &7► &eBaşarıyla Satın Aldın."
			remove 300000 from {dirhem::%player%}
			execute console command "cc give p tera 1 %player%"
		else:
			send "&6SkyBlock &7► &eYeterli dirhem'in yok."
		
