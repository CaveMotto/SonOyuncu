command /bitcoin [<text>] [<text>]:
    trigger:
        arg 1 is not set:
            execute player command "48twatwa4yşn90"
        arg 1 is "bakiyem":
            arg 1 is set:
                execute player command "btc balance"
            else if arg 1 is not set:
                send "yardım"
            else if arg 2 is not set:
                send "oyuncu ismi belirtmedin" 
        arg 1 is "fiyat":
            arg 1 is set:
                execute player command "btc price 1"
            else if arg 1 is not set:
                send "yardım"
            else if arg 2 is not set:
                send "mesaj yazmadın"
        arg 1 is "gönder":
            arg 1 is set:
                execute player command "btc send %arg-2%"
            else if arg 1 is not set:
                send "yardım"
            else if arg 2 is not set:
                send "mesaj yazmadın"
        arg 1 is "al":
            arg 1 is set:
                execute player command "btc buy %arg-2%"
            else if arg 1 is not set:
                send "yardım"
            else if arg 2 is not set:
                send "mesaj yazmadın"
        arg 1 is "sat":
            arg 1 is set:
                execute player command "btc sell %arg-2%"
            else if arg 1 is not set:
                send "yardım"
            else if arg 2 is not set:
                send "mesaj yazmadın"

command /48twatwa4yşn90:
    trigger:
        send "&e&l&m--------------&6 &6Bitcoin &e&l&m--------------&6"
        send ""
        send "&6/Bitcoin bakiyem &7- &eBitcoin hesabına bakar."
        send "&6/Bitcoin fiyat &7- &eBitcoin yükselişini ve artışını izlersin"
        send "&6/Bitcoin al (miktar) &7- &eBitcoin satın alabilirsin."
        send "&6/Bitcoin sat (miktar) &7- &eBitcoin satabilirsin."
        send "&6/Bitcoin gönder (oyuncu) (miktar) &7- &eOyuncuya bitcoin gönderirsin."
        send ""
        send "&e&l&m--------------&6 &6Bitcoin &e&l&m--------------&6"


