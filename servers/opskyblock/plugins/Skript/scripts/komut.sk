command /arenaberlile:
    permission: op
    trigger:
        add player's location to {liste::*}
        send "&6Skyblock &7► &eArena bölgesi belirlendi"
command /arenasil:
    permission: op
    trigger:
        remove player's location from {liste::*}
        send "&6Skyblock &7► &eArena bölgesi silindi"
on walk on end portal frame:
    set {_location::%player%} to random element of {liste::*}
    teleport player to {_location::%player%}
    send "&6Skyblock &7► &eArena bölgesine ışınlandın."

options:
    reklam1: batihost" or "keyubu" or "rabisu" or "play" or "com" or "mc" or "net" or "network" or "nw" or "com
options:
    küfür1: mk" or "öç" or "
options:
    argo1: argo1" or "argo2" or "argo3

on load:
    {reklamkoruma::laros} is not set:
        set {reklamkoruma::laros} to "&cKapalı"
    {küfürkoruma::laros} is not set:
        set {küfürkoruma::laros} to "&cKapalı"
    {argokoruma::laros} is not set:
        set {argokoruma::laros} to "&cKapalı"


command /otomute [<text>]:
    permission: op
    trigger:
        if arg 1 is not set:
            send "            &e&lOTOMUTE &8| &eV2            "
            send "                                            "
            send "&7Reklam - Durum &8► %{reklamkoruma::laros}%"
            send "&7Küfür - Durum &8► %{küfürkoruma::laros}%  "
            send "&7Argo - Durum &8► %{argokoruma::laros}%    "
        if arg 1 is "reklam aç":
            set {reklamkoruma::laros} to "&aAktif"
            send "&6Skyblock &8► &7başarılı şekilde &d&nReklam&r &7koruma açıldı &aAçıldı!"
        if arg 1 is "reklam kapat":
            set {reklamkoruma::laros} to "&cKapalı"
            send "&6Skyblock &8► &7başarılı şekilde &d&nReklam&r &7koruma &cKapatıldı!"
        if arg 1 is "küfür aç":
            set {küfürkoruma::laros} to "&aAktif"
            send "&6Skyblock &8► &7başarılı şekilde &d&nKüfür&r &7koruma açıldı &aAçıldı!"
        if arg 1 is "küfür kapat":
            set {küfürkoruma::laros} to "&cKapalı"
            send "&6Skyblock &8► &7başarılı şekilde &d&nKüfür&r &7koruma &cKapatıldı!"
        if arg 1 is "argo aç":
            set {argokoruma::laros} to "&aAktif"
            send "&6Skyblock &8► &7başarılı şekilde &d&nArgo&r &7koruma açıldı &aAçıldı!"
        if arg 1 is "argo kapat":
            set {argokoruma::laros} to "&cKapalı"
            send "&6Skyblock &8► &7başarılı şekilde &d&nArgo&r &7koruma &cKapatıldı!"

on chat:
    if {reklamkoruma::laros} is "&aAktif":
        if message contains "{@reklam1}":
            {reklam::%player%} is not set:
                set {reklam::%player%} to 1
                cancel event
                send "&6Skyblock &8► &7Dostum Yazdığın Sohbete &aReklam &7içreiyor birdaha yazma!"
                stop
            else:
                delete {reklam::%player%}
                execute console command "/sil"
                wait 1 tick
                broadcast "&6Skyblock &8► &a%player% &7adlı oyuncu reklam yaptığı için &a60 Dakkika &7susturuldu!"
                execute console command "/emute %player% 60m"
on chat:
    if {küfürkoruma::laros} is "&aAktif":
        if message is "{@küfür1}":
            {küfür::%player%} is not set:
                set {küfür::%player%} to 1
                cancel event
                send "&6Skyblock &8► &7Dostum Yazdığın Sohbete &aKüfür &7içreiyor birdaha yazma!"
                stop
            else:
                delete {küfür::%player%}
                execute console command "/sil"
                wait 1 tick
                broadcast "&6Skyblock &8► &a%player% &7adlı oyuncu küfür ettiği için &a10 Dakkika &7susturuldu!"
                execute console command "/emute %player% 10m"
on chat:
    if {argokoruma::laros} is "&aAktif":
        if message contains "{@argo1}":
            {argo::%player%} is not set:
                set {argo::%player%} to 1
                cancel event
                send "&6Skyblock &8► &7Dostum Yazdığın Sohbete &aArgo &7içreiyor birdaha yazma!"
                stop
            else:
                delete {argo::%player%}
                execute console command "/sil"
                wait 1 tick
                broadcast "&6Skyblock &8► &a%player% &7adlı oyuncu argo kullandığı için &a5 Dakkika &7susturuldu!"
                execute console command "/emute %player% 5m"
        
on quit:
    delete {reklam::%player%}
    delete {küfür::%player%}
    delete {argo::%player%}
	
	
command /discord:
    trigger:
        send "&e" to player
        send "&e             &aDiscord'a &7katılarak arkadaşlarınla sohbet et!" to player
        send "&e            &7veya arkadaşlarınla sohbet ederek oynayabilirsin!" to player
        send "&e" to player
        send "&e                      https://discord.gg/laros " to player
        send "&e" to player
