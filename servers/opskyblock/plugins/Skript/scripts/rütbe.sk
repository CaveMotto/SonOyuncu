options:
	p: &6Skyblock &7► 
	levelhata: &eada seviyeniz yetmiyor.
	parahata: &eparanız yeterli değil.
	alinmis: &eÜzgünüm, bu rütbeyi zaten daha önce almışsınız.	
	
command /rütbesifirla [<offlineplayer>]:
    permission: op
    trigger:
        if arg-1 exist:
            delete {skyold::%arg-1%}
            delete {skynew::%arg-1%}
            delete {skyarmy::%arg-1%}
            delete {skycaptain::%arg-1%}
            delete {skywarrant::%arg-1%}
            delete {skyairman::%arg-1%}
            delete {skyking::%arg-1%}
            delete {skypro::%arg-1%}
            delete {skychef::%arg-1%}
        else:
            send "{@p} &eOyuncu ismi girin &d/rütbesifirla <player>"          

	
command /larosoldrank:
	trigger:
		if player's group is "moderator" or "yardımcı":
			send "{@p} &eEkip üyeleri bu rütbeler ulaşamaz."
			stop
		if asb player's island level is greater than 10000:
			if {skyold::%player%} is not set:
				if player's balance >= 50000:
					remove 50000 from player's money
					set {skyold::%player%} to true
					execute console command "lp user %player% permission set deluxetags.tag.skyold"
					execute console command "lp user %player% permission unset deluxetags.tag.basic"
					send "{@p} &eBaşarıyla &dSkyOld &erütbesine ulaştınız."
					wait 0.3 seconds
					execute console command "tags set %player% skyold"
				else:
					send "{@p} {@parahata}"
			else:
				send "{@p} {@alinmis}" to player
		else:
			send "{@p} {@levelhata}" to player
			
command /larosnewrank:
	trigger:
		if player's group is "moderator" or "yardımcı":
			send "{@p} &eEkip üyeleri bu rütbeler ulaşamaz."
			stop
		if asb player's island level is greater than 30000:
			if {skyold::%player%} is set:
				if {skynew::%player%} is not set:
					if player's balance >= 50000:
						remove 50000 from player's money
						set {skynew::%player%} to true
						execute console command "lp user %player% permission set deluxetags.tag.skynew"
						execute console command "lp user %player% permission unset deluxetags.tag.skyold"
						send "{@p} &eBaşarıyla &dSkyNew &erütbesine ulaştınız."
						wait 0.3 seconds
						execute console command "tags set %player% skynew"
					else:
						send "{@p} {@parahata}"
				else:
					send "{@p} {@alinmis}"
			else:
				send "{@p} &eBu rütbe için önce &dSkyOld &erütbesine ulaşmalısın."
		else:
			send "{@p} {@levelhata}" to player
		
