on explode:
      cancel event
		
on command:
	if command contains "minecraft:":
		cancel event	

on command:
	full command contains "pay"
	full command contains "." or ","
	cancel event
	send "&6Survival &8► &ePara gönderirken &6nokta &eve &6virgül &ekullanamazsınız!"
			
